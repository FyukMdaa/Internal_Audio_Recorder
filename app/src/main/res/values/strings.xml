    <string name="settings_threshold_desc">Audio below this level counts as silence. Lower (more negative) values keep quieter passages.</string>
    <string name="settings_min_silence_title">Minimum silence: %1$.1f s</string>
    <string name="settings_min_silence_desc">Only gaps at least this long are proposed for cutting.</string>
    <string name="settings_padding_title">Padding: %1$.2f s</string>
    <string name="settings_padding_desc">Audio kept before and after each cut so words are not clipped.</string>
